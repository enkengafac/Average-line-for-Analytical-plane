        "\n",
        "# Create a DataFrame for features and their corresponding coefficients\n",
        "coefficients = pd.DataFrame({\n",
        "    'Feature': X.columns,\n",
        "    'Coefficient': model.coef_\n",
        "})\n",
        "\n",
        "# Sort by absolute coefficient value to see the magnitude of impact\n",
        "coefficients['Absolute_Impact'] = coefficients['Coefficient'].abs()\n",
        "coefficients = coefficients.sort_values(by='Absolute_Impact', ascending=False).reset_index(drop=True)\n",
        "\n",
